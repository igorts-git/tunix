ARG BASE_IMAGE=gcr.io/cloud-tpu-multipod-dev/yixuannwang_google_com-runner:yixuann-pr-tunix-2202-09120021
FROM ${BASE_IMAGE}

# The build context is a staging directory holding both checkouts side by side; see
# build_repro_image.sh, which assembles one. Overlaying the sources rather than
# reinstalling leaves the base image's pinned jax/libtpu/raiden ABI alone.
ARG TUNIX_DEST=/app/tunix
ARG MAXTEXT_DEST=/app/maxtext

COPY tunix ${TUNIX_DEST}
COPY maxtext ${MAXTEXT_DEST}

# Wrong *_DEST paths would ship the unpatched sources, and the failure would only surface
# hours into a run as an OOMKilled proxy or a 15-minute retracing step. Fail the build.
RUN python -c "\
import inspect; \
from maxtext.training_engine import maxtext_engine; \
from tunix.experimental.orchestrator import algorithm_adapter; \
save = inspect.getsource(maxtext_engine.MaxTextTrainingEngine.save_checkpoint); \
assert 'is_pathways_backend_used' in save, 'maxtext overlay missed: ' + maxtext_engine.__file__; \
assert 'metadata={}' in inspect.getsource(algorithm_adapter), 'tunix overlay missed: ' + algorithm_adapter.__file__; \
print('overlay verified')"
